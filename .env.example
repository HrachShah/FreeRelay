# ─────────────────────────────────────────────────────
# FreeRelay — Environment Configuration
# Copy this file to .env and add at least one API key.
# ─────────────────────────────────────────────────────

# ── Provider API Keys (add at least one) ─────────────
# Get free at: https://console.groq.com/keys
GROQ_API_KEY=

# Get free at: https://aistudio.google.com/apikey
GOOGLE_AI_KEY=

# Get free at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Get free at: https://api.together.xyz
TOGETHER_API_KEY=

# Get free at: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# ── Gateway Settings (all optional) ──────────────────
# FREERELAY_HOST=0.0.0.0
# FREERELAY_PORT=8000
# FREERELAY_API_KEY=              # Set to require auth from clients
# FREERELAY_ENABLE_AUTH=false
# FREERELAY_LOG_LEVEL=INFO
# FREERELAY_LOG_FORMAT=console    # "json" for production

# ── Redis (optional, enables caching + distributed state)
# FREERELAY_ENABLE_REDIS=false
# FREERELAY_REDIS_URL=redis://localhost:6379

# ── Features ─────────────────────────────────────────
# FREERELAY_ENABLE_CACHE=false
# FREERELAY_ENABLE_COMPRESSION=true
# FREERELAY_ENABLE_HEDGING=false
# FREERELAY_ENABLE_CHAOS=false
# FREERELAY_CHAOS_INTENSITY=0.1
# FREERELAY_MAX_REPAIR_ATTEMPTS=1

# ── Timeouts ─────────────────────────────────────────
# FREERELAY_REQUEST_TIMEOUT=60
