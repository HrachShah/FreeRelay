# ─────────────────────────────────────────────────────
# FreeRelay — Environment Configuration
# Copy this file to .env and configure your keys.
# ─────────────────────────────────────────────────────

# ── Mode: "free", "paid", or "auto" (default)
#   free  = use only free providers (Groq, Google, etc.)
#   paid  = use only paid providers (OpenAI, Anthropic)
#   auto  = use free by default, paid for complex tasks
FREERELAY_MODE=auto

# ── Free Provider API Keys ────────────────────────────
# Get free keys from:
GROQ_API_KEY=           # https://console.groq.com/keys
GOOGLE_AI_KEY=          # https://aistudio.google.com/apikey
OPENROUTER_API_KEY=      # https://openrouter.ai/keys
TOGETHER_API_KEY=       # https://api.together.xyz
MISTRAL_API_KEY=        # https://console.mistral.ai/api-keys
NVIDIA_API_KEY=         # https://build.nvidia.com/explore/recommended

# ── Paid Provider API Keys (optional) ────────────────
# For complex tasks in auto mode, or use in "paid" mode:
OPENAI_API_KEY=         # https://platform.openai.com/api-keys
ANTHROPIC_API_KEY=      # https://console.anthropic.com/settings/keys

# ── Gateway Settings ─────────────────────────────────
# FREERELAY_HOST=0.0.0.0
# FREERELAY_PORT=8000
# FREERELAY_API_KEY=              # Set to require auth from clients
# FREERELAY_ENABLE_AUTH=false
# FREERELAY_LOG_LEVEL=INFO
# FREERELAY_LOG_FORMAT=console    # "json" for production

# ── Supabase (Authentication & Usage Tracking) ───────
# FREERELAY_ENABLE_SUPABASE_AUTH=false
# FREERELAY_SUPABASE_URL=
# FREERELAY_SUPABASE_KEY=
# FREERELAY_SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (Payments) ────────────────────────────────
# FREERELAY_STRIPE_SECRET_KEY=
# FREERELAY_STRIPE_WEBHOOK_SECRET=
# FREERELAY_STRIPE_SUCCESS_URL=http://localhost:8000/success
# FREERELAY_STRIPE_CANCEL_URL=http://localhost:8000/cancel

# ── Redis (optional) ─────────────────────────────────
# FREERELAY_ENABLE_REDIS=false
# FREERELAY_REDIS_URL=redis://localhost:6379

# ── Features ─────────────────────────────────────────
# FREERELAY_ENABLE_CACHE=false
# FREERELAY_ENABLE_COMPRESSION=true
# FREERELAY_ENABLE_HEDGING=false
# FREERELAY_ENABLE_CHAOS=false
# FREERELAY_CHAOS_INTENSITY=0.1
